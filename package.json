{
  "name": "business-type-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "typecheck:domain": "tsc -p tsconfig.domain.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test:domain:self": "node --import ts-node/register scripts/domain-self-check.ts",
    "test:unit": "vitest run",
    "checks": "npm run typecheck && npm run lint && npm run test:domain:self && npm run test:unit && npm run build",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#03080f' --iconBackgroundColorDark '#03080f' --splashBackgroundColor '#070f18' --splashBackgroundColorDark '#070f18'",
    "native:setup": "node scripts/setup-native.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "hono": "^4.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
