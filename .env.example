# Client (browser / Capacitor). Point at your Hostinger nginx /api proxy.
# Example local with Vite proxy: VITE_API_URL=/api
# Example Capacitor against VPS: VITE_API_URL=https://game.your-domain.tld/api
VITE_API_URL=

# --- Server-only (deploy/.env / API container) — never VITE_* ---
# DATABASE_URL=postgres://businesstype:...@db:5432/businesstype
# JWT_SECRET=
# CORS_ORIGIN=http://localhost:5173
# COOKIE_SECURE=false
# AUTH_DEV_CAPTURE=1
# PUBLIC_APP_URL=http://localhost:5173
# AUTH_REGISTER_HOURLY_LIMIT=10
# AUTH_LOGIN_HOURLY_LIMIT=30
# AUTH_RESET_HOURLY_LIMIT=10
# OLLAMA_API_KEY=
# LLM_BASE_URL=https://ollama.com/v1
# LLM_MODEL=gpt-oss:120b
# LLM_FALLBACK_MODEL=llama3.1:8b
# TAVILY_API_KEY=

# Native session storage uses @capacitor/preferences. For stronger encryption on device,
# swap to a Secure Storage / Keychain plugin without changing API contracts.
