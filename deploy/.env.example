# Hostinger KVM2 — Business Type beside n8n
WEB_PORT=8088
VITE_API_URL=/api
# Traefik Host() rule (HTTPS via existing host Traefik + Let's Encrypt)
PUBLIC_HOST=businesstypesim.raccoova.com

# Postgres (internal only)
POSTGRES_USER=businesstype
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=businesstype

# API secrets
JWT_SECRET=change-me-to-a-long-random-string
# Prefer your HTTPS origin once Traefik is live
CORS_ORIGIN=https://businesstypesim.raccoova.com

# Ollama Cloud — https://ollama.com/settings/keys
OLLAMA_API_KEY=
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=gpt-oss:120b
LLM_FALLBACK_MODEL=llama3.1:8b
LLM_TIMEOUT_MS=25000

# Optional real-world debrief
# TAVILY_API_KEY=
AI_HOURLY_LIMIT=30
